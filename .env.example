STT_BASE_URL=https://api.siliconflow.cn/v1
TTS_API_KEY=
TTS_BASE_URL=https://api.siliconflow.cn/v1

# Explicit Fallbacks
SILICONFLOW_API_KEY=
OPENAI_API_KEY=

# Volcengine Doubao Settings
ARK_API_KEY=
ARK_AUDIO_MODEL=doubao-seed-2-0-lite-260428
ARK_DRAW_MODEL=doubao-seedream-5-0-pro-260628
ARK_TTS_MODEL=Doubao-Seed-VoiceDesign-1.0
EMBEDDING_MODEL_VISION=doubao-embedding-vision-251215
EMBEDDING_MODEL_TEXT=doubao-embedding-large-text-250515
